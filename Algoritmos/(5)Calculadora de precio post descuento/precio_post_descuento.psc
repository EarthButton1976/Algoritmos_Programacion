// Realizar un algoritmo en pseudocódigo que calcule el costo final de un producto posterior a un descuento
//Calcule el precio total de un producto  con un descuento del 15%
Algoritmo precio_post_descuento
	Definir precio Como Real
	Descuento=0.85
	
	Escribir "Cual es el precio de su compra"
	leer precio
	
	precio_final=precio*descuento
	escribir "Su precio final, con el descuento del 15% es de: ", precio_final
FinAlgoritmo
