// Realizar un algoritmo en pseudocódigo que calcule el crecimiento del dinero invertido en el banco
//Calcule e imprima la suma la cantidad de dinero ganada con una razón del 2% mensual después de un mes
Algoritmo Calculadora_crecimiento_dinero
	
	Definir dinero Como Real
	
	Escribir "¿Cuanto dinero invirtió en este banco?"
	Leer dinero
	
	Total= dinero*1.02
	
	Escribir "Su balance este mes es de: ", Total
	
FinAlgoritmo
