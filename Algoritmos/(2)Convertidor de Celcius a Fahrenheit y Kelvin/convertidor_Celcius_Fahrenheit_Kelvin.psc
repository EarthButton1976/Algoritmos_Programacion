// Realizar un algoritmo en pseudocódigo para convertir grados Celcius a Kelvin y Farenheit
//Convertir los numeros que regristre el usuario a kalvin y fahrenheit

Algoritmo convertidor_Celcius_Fahrenheit_Kelvin
	Definir C Como Real
	Definir F Como Real
	Definir K Como Real
	
	Escribir "Ingrese la cantidad de Celcius que desea convertir: "
	Leer C
	
	F=(C*1.8)+32
	K=C+273.15
	
	Escribir C " grados Celcius son: " F " grados Fahrenheit"
	
	Escribir C " grados Celcius son: " K " grados Kelvin"
		
FinAlgoritmo
